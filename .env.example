# SepsiGuard environment configuration (copy to .env and adjust)

# PostgreSQL connection (docker-compose default)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sepsiguard
POSTGRES_USER=sepsiguard
POSTGRES_PASSWORD=sepsiguard_research

# Connection used by the backend service
DATABASE_URL=postgresql://sepsiguard:sepsiguard_research@postgres:5432/sepsiguard

# Model registry
MODEL_REGISTRY_DIR=/app/artifacts/model_registry
MODEL_VERSION=sepsiguard_v1.0

# Replay engine
REPLAY_SPEED=60          # simulated seconds per real second (60 = 1 hour per minute)

# API
API_HOST=0.0.0.0
API_PORT=8000