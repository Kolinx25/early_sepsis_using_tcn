# SepsiGuard frontend: React + TypeScript + Tailwind (built with Vite)
# Build context: ./app/frontend
FROM node:22-slim AS build
WORKDIR /app/frontend
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app/frontend
COPY --from=build /app/frontend ./
ENV VITE_API_TARGET=http://backend:8000
EXPOSE 3000
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]